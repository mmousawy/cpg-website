# GoTrue / Auth settings for staging Supabase
# Edit /data/supabase-staging/.env (not production /home/ubuntu/supabase-project/.env)

SITE_URL=https://staging.creativephotography.group
API_EXTERNAL_URL=https://db-staging.creativephotography.group
SUPABASE_PUBLIC_URL=https://db-staging.creativephotography.group

# Disable public registration on staging
GOTRUE_DISABLE_SIGNUP=true

# Allow redirects back to the staging Next app
GOTRUE_URI_ALLOW_LIST=https://staging.creativephotography.group/**

# OAuth — copy client IDs/secrets from production .env. Add this callback in
# Google/Discord consoles (GoTrue, not the Next.js /auth-callback route):
# https://db-staging.creativephotography.group/auth/v1/callback
#
# These keys must also be listed in docker-compose for the auth service.
# Stock compose does not pass them — use docker-compose.override.yml (this
# repo's override.example) or: bash infra/apply-supabase-oauth.sh staging
# Confirm: docker exec supabase-staging-auth env | grep GOTRUE_EXTERNAL_GOOGLE
GOTRUE_EXTERNAL_GOOGLE_ENABLED=true
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=
GOTRUE_EXTERNAL_GOOGLE_SECRET=
GOTRUE_EXTERNAL_GOOGLE_REDIRECT_URI=https://db-staging.creativephotography.group/auth/v1/callback
GOTRUE_EXTERNAL_DISCORD_ENABLED=true
GOTRUE_EXTERNAL_DISCORD_CLIENT_ID=
GOTRUE_EXTERNAL_DISCORD_SECRET=
GOTRUE_EXTERNAL_DISCORD_REDIRECT_URI=https://db-staging.creativephotography.group/auth/v1/callback

# Optional: disable SMTP on staging so auth emails are not sent to real inboxes
# GOTRUE_SMTP_HOST=
# GOTRUE_SMTP_PORT=
