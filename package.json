{
  "name": "cpg-website",
  "version": "1.41.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "dev:debug": "cross-env NODE_OPTIONS=\"--inspect --require ./scripts/memlog.mjs\" next dev",
    "dev:debug:webpack": "cross-env NODE_OPTIONS=\"--inspect --require ./scripts/memlog.mjs\" next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint --fix \"src/**/*.{ts,tsx}\"",
    "typecheck": "rm -rf .next/dev/types && next typegen && tsc --noEmit",
    "typecheck:clean": "rm -rf .next/cache/.tsbuildinfo .next/dev/types && next typegen && tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "check": "npm run lint && npm run typecheck:clean && npm run test:run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "scrape:all": "npx tsx scripts/scrape-uitagenda-events.ts && npx tsx scripts/scrape-tpc-events.ts && npx tsx scripts/scrape-cameranu-events.ts",
    "verify:jwt": "node scripts/verify-jwt-signing.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-select": "^2.3.7",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@vercel/analytics": "^2.0.1",
    "@wrksz/themes": "^1.2.0",
    "blurhash": "^2.0.5",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "dotenv": "^17.4.2",
    "exifr": "^7.1.3",
    "focus-trap-react": "^12.0.3",
    "image-size": "^2.0.2",
    "nanoid": "^6.0.1",
    "next": "16.3.4",
    "photoswipe": "^5.4.4",
    "piexifjs": "^1.0.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-easy-crop": "^6.2.3",
    "react-hook-form": "^7.87.0",
    "react-markdown": "^10.1.0",
    "react-quill-new": "^3.8.3",
    "recharts": "^3.10.1",
    "resend": "^6.25.0",
    "sanitize-html": "^2.17.7",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "sonner": "^2.0.8",
    "swiper": "^14.2.0",
    "tailwind-merge": "^3.6.0",
    "wawoff2": "^2.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "16.3.4",
    "@playwright/test": "^1.62.1",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^6.1.1",
    "critters": "^0.0.25",
    "cross-env": "^10.1.0",
    "eslint": "^10.9.1",
    "eslint-config-next": "16.3.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "postcss": "^8",
    "supabase": "^2.116.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vitest": "^4.1.11"
  }
}
