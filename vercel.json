{
  "installCommand": "npx pnpm@11.17.0 install --frozen-lockfile",
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:woff2|ico|svg|png|webp|jpg|jpeg))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/event-reminders",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 8 * * 0"
    },
    {
      "path": "/api/cron/revalidate-events",
      "schedule": "1 13 * * *"
    },
    {
      "path": "/api/cron/revalidate-events",
      "schedule": "1 17 * * *"
    },
    {
      "path": "/api/cron/cleanup-deleted-content",
      "schedule": "0 3 * * 0"
    }
  ]
}
